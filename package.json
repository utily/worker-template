{
	"name": "@utily/worker-template",
	"version": "0.1.3",
	"description": "Typescript template for Cloudflare Worker.",
	"author": "Utily Contributors",
	"license": "MIT",
	"private": false,
	"repository": "https://github.com/utily/worker-template",
	"bugs": {
		"url": "https://github.com/utily/worker-template/issues"
	},
	"homepage": "https://github.com/utily",
	"main": "dist/_worker.js",
	"typings": "dist/index.d.ts",
	"type": "module",
	"git": {
		"tagName": "v${version}"
	},
	"github": {
		"release": true
	},
	"scripts": {
		"lint": "biome format .",
		"format": "biome format --write .",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"build": "wrangler deploy --dry-run --outdir=dist",
		"transpile": "tsc --noEmit -p tsconfig.json",
		"deploy": "wrangler deploy --env production",
		"login": "wrangler login",
		"start": "wrangler dev --live-reload --env local --inspector-port 9229",
		"clean": "rimraf dist node_modules coverage",
		"verify": "npm run lint && npm run test && npm run build && npm audit --omit=dev"
	},
	"overrides": {
		"esbuild": ">=0.25.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@cloudflare/workers-types": "^5.20261123.1",
		"@vitest/coverage-v8": "^5.1.1",
		"rimraf": "^6.1.4",
		"tslib": "^2.9.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0"
	},
	"dependencies": {
		"cloudly-http": "0.2.0-alpha.24",
		"cloudly-router": "1.0.1-alpha.0",
		"gracely": "2.0.10"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261119.1": true
	}
}
