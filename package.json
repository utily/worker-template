{
	"name": "@utily/worker-template",
	"version": "0.1.3",
	"description": "Typescript template for Cloudflare Worker.",
	"author": "Utily Contributors",
	"license": "MIT",
	"private": false,
	"repository": "https://github.com/utily/worker-template",
	"bugs": {
		"url": "https://github.com/utily/worker-template/issues"
	},
	"homepage": "https://github.com/utily",
	"main": "dist/_worker.js",
	"typings": "dist/index.d.ts",
	"type": "module",
	"git": {
		"tagName": "v${version}"
	},
	"github": {
		"release": true
	},
	"scripts": {
		"lint": "eslint --max-warnings=0 '**/*.{ts,tsx}'",
		"fix": "eslint '**/*.{ts,tsx}' --fix",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"types": "wrangler types --env-interface=Environment",
		"build": "wrangler deploy --dry-run --outdir=dist",
		"transpile": "tsc --build tsconfig.json -noEmit",
		"deploy": "wrangler deploy --env production",
		"login": "wrangler login",
		"start": "wrangler dev --live-reload --env \"\"",
		"clean": "rimraf dist node_modules coverage",
		"install": "npm i --min-release-age=0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"prettier": "3.8.4",
		"rimraf": "^6.1.4",
		"tslib": "2.9.1",
		"typescript": "6.0.3",
		"vitest": "5.1.0",
		"wrangler": "4.157.0"
	},
	"dependencies": {
		"@types/node": "26.6.5",
		"cloudly-http": "0.2.0-alpha.24",
		"cloudly-router": "1.0.1-alpha.6",
		"gracely": "2.0.11"
	}
}
